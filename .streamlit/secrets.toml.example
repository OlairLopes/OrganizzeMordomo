# Copie este arquivo para .streamlit/secrets.toml (local) ou cole o conteúdo
# em App settings > Secrets no Streamlit Community Cloud.
# NUNCA faça commit do arquivo .streamlit/secrets.toml real — ele já está no .gitignore.

# Senha única para acessar o app. Se não for definida, o app fica aberto sem login.
APP_PASSWORD = "troque-por-uma-senha-forte"

# Chave da API da Anthropic, usada apenas pela aba "Assistente".
# Opcional: sem ela, o app funciona normalmente, só o chat fica desativado.
ANTHROPIC_API_KEY = "sk-ant-..."
